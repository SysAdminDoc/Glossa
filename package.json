{
  "name": "glossa",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Private, on-device web page translation for Chrome and Firefox. No cloud, no account, no telemetry.",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SysAdminDoc/Glossa.git"
  },
  "homepage": "https://github.com/SysAdminDoc/Glossa",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "engine:fetch": "node tools/fetch-engine.mjs",
    "icons": "node tools/icons.mjs",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "smoke": "node tools/build.mjs --smoke && node tests/smoke/chromium.smoke.mjs",
    "smoke:firefox": "node tools/build.mjs --smoke && python tests/smoke/firefox.smoke.py",
    "smoke:a11y": "node tools/build.mjs --smoke && node tests/smoke/a11y.smoke.mjs",
    "smoke:i18n": "node tools/build.mjs --smoke && node tests/smoke/i18n.smoke.mjs",
    "screenshots": "node tools/build.mjs --smoke && node tools/screenshots.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:release": "npm run verify && npm run smoke && npm run smoke:a11y && npm run smoke:i18n && npm run smoke:firefox",
    "source:archive": "node tools/source-archive.mjs",
    "verify:source": "node tools/build.mjs && node tools/source-archive.mjs && node tools/verify-source.mjs",
    "bump": "node tools/bump.mjs",
    "release": "node tools/release.mjs",
    "release:publish": "node tools/release.mjs --publish"
  },
  "dependencies": {
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "20.14.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
